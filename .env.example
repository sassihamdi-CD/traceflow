# TraceFlow API — copy to .env and fill in (keys supplied at Phase 1 auth setup)
# Pilot local run: `cp .env.example .env`, set DB_APP_PASSWORD + Supabase keys, `docker compose up --build`.
DATABASE_URL=postgresql://traceflow_app:change-me@localhost:5432/traceflow
# Local-only Postgres app password used by docker-compose (never commit a real one).
DB_APP_PASSWORD=change-me-local-only
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=change-me (server validates sessions via the Supabase Auth API; no JWT secret needed)
# Correction 3: single-workspace pilot — hardcoded workspace id, no user->workspace lookup table
WORKSPACE_ID=00000000-0000-0000-0000-000000000000
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=traceflow-docs (verified live: bucket exists, put/get/delete round-trip OK)
ANTHROPIC_API_KEY=sk-ant-change-me
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Comma-separated browser origins allowed via CORS (no cookies/credentials; Bearer only).
FRONTEND_URL=http://localhost:3001
# Shared secret for POST /api/intake/email (email provider webhook). Empty = 503.
INTAKE_SECRET=change-me
PORT=8000
