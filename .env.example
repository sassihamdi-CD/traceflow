# TraceFlow API — copy to .env.<company> per manufacturer company and fill in.
# SEPARATE DATABASE per company (decision 2026-10-07): one .env file, one
# DATABASE_URL, one WORKSPACE_ID per company. Never share a DB across companies.
# See docs/COMPANY_PROVISIONING.md for the full per-company checklist.
DATABASE_URL=postgresql://traceflow_app:change-me@localhost:5432/traceflow
# Local-only Postgres app password used by docker-compose (never commit a real one).
DB_APP_PASSWORD=change-me-local-only
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=change-me (server validates sessions via the Supabase Auth API; no JWT secret needed)
# Correction 3: single-workspace pilot — hardcoded workspace id, no user->workspace lookup table
# Per-company: generate ONE uuid per company (uuidgen) and seed it via provisioning.
WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# R2 object prefix per company: {WORKSPACE_ID}/{product_id}/{uuid}-{basename}.
# One shared bucket is OK; isolation comes from the workspace prefix.
# Never reuse a prefix across companies.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=traceflow-docs (verified live: bucket exists, put/get/delete round-trip OK)
ANTHROPIC_API_KEY=sk-ant-change-me
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Comma-separated browser origins allowed via CORS (no cookies/credentials; Bearer only).
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Shared secret for POST /api/intake/email (email provider webhook). Empty = 503.
# Per-company: generate a fresh 32-byte secret per company (openssl rand -hex 32).
INTAKE_SECRET=change-me
# TraceFlow founder key (SERVER-ONLY, never NEXT_PUBLIC_): unlocks /founder
# + /api/founder/* where company codes are minted. Empty = founder area off.
FOUNDER_KEY=change-me-server-side-only
PORT=8000
# Pilot console (Next.js) served by `docker compose up` on WEB_PORT.
WEB_PORT=3000
# Frontend build args (baked into the web image at build time — re-run
# `docker compose up --build` after changing them).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
